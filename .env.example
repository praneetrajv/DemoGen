# LLM via Groq (OpenAI-compatible chat completions endpoint)
OPENROUTER_API_KEY=your_api_key_here
OPENROUTER_MODEL=openai/gpt-oss-20b
OPENROUTER_API_BASE=https://api.groq.com/openai/v1/chat/completions
OPENROUTER_REASONING_ENABLED=false

# Gemini API Configuration
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.0-flash-thinking-exp-01-21

# Storage Configuration
STORAGE_TYPE=local
OUTPUT_DIR=./outputs
VIDEO_OUTPUT_DIR=./outputs/videos
NARRATION_OUTPUT_DIR=./outputs/narration
DOM_SNAPSHOT_DIR=./outputs/dom_snapshots

# NeevCloud Configuration (Add credentials when you have them)
NEEVCLOUD_URL=https://en.wikipedia.org
NEEVCLOUD_TEST_EMAIL=
NEEVCLOUD_TEST_PASSWORD=
NEEVCLOUD_AUTO_LOGIN=false
USE_MOCK_SITE_BY_DEFAULT=false

# TTS Configuration
TTS_PROVIDER=gtts
ELEVENLABS_API_KEY=

# Application Configuration
APP_ENV=development
APP_DEBUG=true
API_PORT=8081
API_HOST=0.0.0.0

# Video Configuration
VIDEO_QUALITY=1080p
VIDEO_FPS=30
VIDEO_CODEC=libx264
AUDIO_BITRATE=128k

# Sentinel Configuration
SENTINEL_CHECK_INTERVAL=86400
DRIFT_DETECTION_THRESHOLD=0.85

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/demogen.log

# Free local browser only (no paid cloud / residential proxy)
# BROWSER_PROVIDER=local | brave
BROWSER_PROVIDER=local
USE_BRAVE=false
SELENIUM_HEADLESS=false

# Database (Optional - skipped for testing)
# DATABASE_URL=postgresql://user:password@localhost:5432/demogen
