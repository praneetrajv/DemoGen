# DemoGen configuration template
# Copy to .env and fill in real values:  cp .env.example .env
# Every key below maps to a field on Settings in config.py. Unknown keys are
# ignored (extra="ignore"), so it is safe to leave commented lines in place.

# ---------------------------------------------------------------------------
# LLM planner (OpenAI-compatible chat-completions API)
# ---------------------------------------------------------------------------
# NOTE: the OPENROUTER_* names are historical. api_base may point at any
# OpenAI-compatible provider -- OpenRouter, Groq, Together, a local vLLM.
# Leave the key blank to run without an LLM: the pipeline falls back to a
# built-in rule-based action plan for the bundled mock site.
OPENROUTER_API_KEY=your_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_API_BASE=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_REASONING_ENABLED=false
OPENROUTER_HTTP_REFERER=https://github.com/demogen
OPENROUTER_APP_TITLE=DemoGen

# Alternative: point the three settings above at Groq instead, e.g.
# OPENROUTER_API_BASE=https://api.groq.com/openai/v1/chat/completions
# OPENROUTER_MODEL=openai/gpt-oss-20b

# ---------------------------------------------------------------------------
# Gemini (optional - only used for visual video validation)
# ---------------------------------------------------------------------------
# Leave blank to skip visual validation entirely. Frame extraction also needs
# the `imageio` package, which is NOT in requirements.txt by default.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-thinking-exp-01-21

# ---------------------------------------------------------------------------
# Storage / output paths
# ---------------------------------------------------------------------------
STORAGE_TYPE=local
OUTPUT_DIR=./outputs
VIDEO_OUTPUT_DIR=./outputs/videos
NARRATION_OUTPUT_DIR=./outputs/narration
DOM_SNAPSHOT_DIR=./outputs/dom_snapshots

# ---------------------------------------------------------------------------
# Demo target
# ---------------------------------------------------------------------------
# With USE_MOCK_SITE_BY_DEFAULT=true the pipeline targets the bundled local
# mock site and NEEVCLOUD_URL is unused.
USE_MOCK_SITE_BY_DEFAULT=true
MOCK_SITE_PORT=8001
MOCK_SITE_HOME_PATH=/dashboard.html
NEEVCLOUD_URL=https://en.wikipedia.org
NEEVCLOUD_TEST_EMAIL=
NEEVCLOUD_TEST_PASSWORD=
NEEVCLOUD_AUTO_LOGIN=false

# ---------------------------------------------------------------------------
# Browser (Playwright / Chromium)
# ---------------------------------------------------------------------------
# Run `python -m playwright install chromium` once before first use.
# headless=false is required for reliable video capture on some Windows setups.
BROWSER_HEADLESS=false
BROWSER_PROVIDER=local
USE_BRAVE=false
# BRAVE_BINARY_PATH=
# BRAVE_USER_DATA_DIR=
# BRAVE_PROFILE=Default
# BRAVE_DEBUGGER_ADDRESS=
BOT_CHALLENGE_TIMEOUT_S=90

# ---------------------------------------------------------------------------
# Narration (TTS)
# ---------------------------------------------------------------------------
TTS_PROVIDER=gtts
ELEVENLABS_API_KEY=

# ---------------------------------------------------------------------------
# Video composition
# ---------------------------------------------------------------------------
VIDEO_QUALITY=1080p
VIDEO_FPS=30
VIDEO_CODEC=libx264
AUDIO_BITRATE=128k

# ---------------------------------------------------------------------------
# DOM drift sentinel
# ---------------------------------------------------------------------------
SENTINEL_CHECK_INTERVAL=86400
DRIFT_DETECTION_THRESHOLD=0.85
AUTO_GENERATE_FOR_DOM_CHANGES=false

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Auto-reload. Leave this off unless you are editing code, and never leave it on
# while generating videos:
#   * on Windows, uvicorn switches to WindowsSelectorEventLoopPolicy whenever it
#     needs a subprocess (reload), and that loop type cannot start Playwright's
#     driver -- every browser launch fails
#   * the file watcher sees the pipeline writing into outputs/ and logs/ and can
#     restart the server mid-generation
API_RELOAD=false
LOG_FILE=logs/demogen.log

# ---------------------------------------------------------------------------
# Database (optional - nothing in the current pipeline requires it)
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/demogen
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=demogen
# DATABASE_USER=postgres
# DATABASE_PASSWORD=password

# ---------------------------------------------------------------------------
# Cloud storage (optional - unused while STORAGE_TYPE=local)
# ---------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=demogen-videos
# GCS_BUCKET=demogen-videos
# GCS_PROJECT_ID=
